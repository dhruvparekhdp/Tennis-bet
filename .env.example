# ── Telegram ────────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, get the token
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxYZ
# Your personal Telegram chat ID (send /start to @userinfobot to get it)
TELEGRAM_CHAT_ID=987654321

# ── Strategy ──────────────────────────────────────────────────────────────────
# Minimum signal confidence (0.0–1.0) to send an alert
MIN_CONFIDENCE=0.65
# Maximum stake as a fraction of bank per bet (hard cap, e.g. 0.03 = 3%)
MAX_STAKE_PCT=0.03
# Your starting/current bank size in your local currency
BANK_SIZE=10000.0

# ── Data collection ───────────────────────────────────────────────────────────
# How often to poll Sofascore for live match updates (seconds, min 20)
SOFASCORE_POLL_INTERVAL=30
# How often to refresh tournament schedule from TheSportsDB (seconds)
SCHEDULE_POLL_INTERVAL=300
# Minimum signal cooldown per match per signal type (minutes)
SIGNAL_COOLDOWN_MINUTES=10

# ── Storage ───────────────────────────────────────────────────────────────────
# For local dev: SQLite (data is lost on Render redeploy — use PostgreSQL in prod)
# DATABASE_URL=sqlite+aiosqlite:///./tennis_bet.db
#
# For production (Render / any PaaS): use a free hosted PostgreSQL:
#   Option 1 — Render PostgreSQL add-on: copy the "External Database URL" from the DB dashboard
#   Option 2 — Neon (free, no credit card): https://neon.tech → copy "Connection string"
#   Option 3 — Supabase (free): https://supabase.com → Settings → Database → Connection string (mode: Session)
#
# Paste the postgres:// or postgresql:// URL directly — the app converts it automatically.
DATABASE_URL=postgresql://user:password@host/dbname

# ── TheSportsDB ───────────────────────────────────────────────────────────────
# Free API key from thesportsdb.com (register for free)
THESPORTSDB_API_KEY=3

# ── Odds API ──────────────────────────────────────────────────────────────────
# Get a free key at https://the-odds-api.com
# Paid plans give in-play (live) odds updated in real time; free tier is pre-match only
ODDS_API_KEY=your_key_here
# How often to poll for odds (seconds). 60 = every minute (recommended for live trading).
# If on free tier (500 req/month) raise this to 3600 to stay within quota.
ODDS_POLL_INTERVAL_SECONDS=60

# ── API-Sports Tennis (live scores + odds, 100 req/day FREE) ─────────────────
# Sign up FREE at https://dashboard.api-football.com/register (no credit card)
# Same key covers tennis.api-sports.io — 100 requests/day permanently free.
# Polls every 15 min (96 req/day) to stay within the free quota.
# Cloud-safe: works on Render, Railway, Fly.io without IP blocks.
API_SPORTS_KEY=your_api_sports_key_here
# How often to poll (seconds). 900 = 15 min = 96 calls/day (fits in 100/day free limit).
# Upgrade to any paid plan to increase the poll frequency.
API_SPORTS_POLL_INTERVAL_SECONDS=900

# ── BetsAPI (live scores + in-play odds, cloud-safe) ─────────────────────────
# Sign up at https://betsapi.com — plans from $10/month
# This is the PRIMARY live data source — works reliably from cloud IPs (Render, Railway, etc.)
# without Cloudflare blocks. Provides: live scores, set-by-set breakdown, in-play odds.
# Set this token to activate live tennis tracking.
BETS_API_TOKEN=your_bets_api_token_here

# ── Sportradar (live scores, all tennis + football) ──────────────────────────
# Free 30-day trial at https://developer.sportradar.com — 1,000 calls/product/30 days.
# Use /settings toggle to pause and save quota when not actively monitoring.
SPORTRADAR_API_KEY=your_sportradar_key_here
SPORTRADAR_POLL_INTERVAL_SECONDS=300

# ── API-Sports Tennis (100 req/day FREE) ──────────────────────────────────────
# Sign up FREE at https://dashboard.api-sports.io — no credit card needed.
# Covers ATP, WTA, ITF live + scheduled matches.
API_SPORTS_KEY=your_api_sports_key_here
API_SPORTS_POLL_INTERVAL_SECONDS=900

# ── SportsData.io Tennis (250 req/day free trial) ────────────────────────────
# Sign up at https://www.sportsdata.io — tennis API included.
# Live + scheduled, cloud-safe, use toggle to pause when not needed.
SPORTSDATA_API_KEY=your_sportsdata_key_here
SPORTSDATA_POLL_INTERVAL_SECONDS=600

# ── API-Tennis.com (no hard quota limits) ─────────────────────────────────────
# Sign up at https://api-tennis.com — REST API (no WebSocket polling overhead).
# Live + scheduled tennis with no credit limits, can poll every 5min aggressively.
API_TENNIS_KEY=your_api_tennis_key_here
API_TENNIS_POLL_INTERVAL_SECONDS=300

# ── Sports master switch ──────────────────────────────────────────────────────
# false = no tennis/football polling at all (no API quota spent, no CPU used).
# The /sports page still renders whatever is already in the DB, it just stops
# receiving new data. Set to true to turn sports collection back on.
SPORTS_ENABLED=false

# ── Crypto & Commodities ──────────────────────────────────────────────────────
# The watchlist itself is NOT configured here — it lives in the database and is
# editable at runtime from the dashboard's Crypto tab (add/remove symbols with
# no redeploy). CRYPTO_WATCHLIST_SEED is only used once, to populate the table
# the first time it's empty (e.g. a brand-new deploy).
CRYPTO_WATCHLIST_SEED=btcusdt,ethusdt,bnbusdt,solusdt,xrpusdt,dogeusdt,adausdt,linkusdt,ltcusdt,dotusdt
CRYPTO_KLINE_INTERVAL=1m
CRYPTO_TIMEFRAMES=30m,1h,4h,1d
CRYPTO_MIN_CONFIDENCE=0.60
CRYPTO_SIGNAL_COOLDOWN_MINUTES=15
CRYPTO_SNAPSHOT_INTERVAL_SECONDS=120
CRYPTO_ALERT_TELEGRAM=true
CRYPTO_MAX_STAKE_PCT=0.02
USE_FINBERT=false
CRYPTO_AUTO_EXECUTE=false

# ── Binance WebSocket (optional, off by default) ──────────────────────────────
# Binance's main host returns HTTP 451 (geo-blocked) from Render's US IPs — that
# is an IP-location block during the connection handshake, so no amount of
# retrying fixes it. Before enabling, hit /api/debug/binance on the live server:
# it probes every candidate host and reports which (if any) actually work.
# If one works, turn this on — Binance klines carry true OHLC (real high/low),
# which makes ATR and therefore signal targets far more realistic than the flat
# snapshots REST polling gives.
BINANCE_WS_ENABLED=false
# Last-resort escape hatch: if /api/debug/binance shows EVERY host geo-blocked,
# route the connection through a proxy that exits in a non-blocked region.
# Leave unset for a normal direct connection — do NOT set it to an empty value.
# BINANCE_PROXY_URL=http://user:pass@your-proxy-host:8080

# ── CoinDCX (preferred crypto price source) ───────────────────────────────────
# Free public ticker API, no key needed — one call returns every market on the
# exchange. Preferred over CoinGecko for any symbol it lists (BTCUSDT,
# BTCINR, etc.) since it's the exact price you'd see trading on CoinDCX.
COINDCX_POLL_INTERVAL_SECONDS=30

# ── CoinGecko (fallback crypto price source) ─────────────────────────────
# Binance's WebSocket API returns HTTP 451 (geoblocked) from Render's IPs, so
# it's disabled by default — CoinGecko REST polling replaces it. No key is
# required (one batched call covers the whole watchlist per poll, well under
# the unauthenticated rate limit). Optional: sign up free at
# https://www.coingecko.com/en/api (no credit card) for a "Demo" key — raises
# the limit to 100 calls/min / 10k/month, useful if you run a large watchlist.
COINGECKO_API_KEY=your_coingecko_demo_key_here
COINGECKO_POLL_INTERVAL_SECONDS=60

# ── Twelve Data (Commodities: Gold, Silver, Crude Oil) — optional ────────────
# Sign up at https://twelvedata.com. If unset, commodities are simply skipped.
TWELVEDATA_API_KEY=your_twelvedata_key_here
TWELVEDATA_SYMBOLS=XAU/USD,XAG/USD,WTI/USD

# ── CryptoPanic (News & Sentiment API) — optional ─────────────────────────────
# NOTE: as of 2026 CryptoPanic's public API requires a paid plan — the free
# tier used during initial development is no longer available. Leave this
# unset to skip sentiment signals entirely; everything else keeps working.
CRYPTOPANIC_AUTH_TOKEN=your_cryptopanic_token_here
CRYPTOPANIC_POLL_INTERVAL_SECONDS=300
